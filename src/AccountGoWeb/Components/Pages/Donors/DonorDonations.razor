@namespace GoodBooks.Donors.Components
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Configuration
@using Dto.Donations
@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration

<PageTitle>Donor Transactions</PageTitle>

<div class="container-fluid">
    <h1 class="h3 mb-3">Donor Transactions @(string.IsNullOrEmpty(donorName) ? "" : "- " + donorName)</h1>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <a class="btn btn-secondary" href="/donors"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Donors</a>
        <a class="btn btn-primary" href="/donor-transactions/new@(DonorId > 0 ? "?donorId=" + DonorId : "")"><i class="fas fa-plus" aria-hidden="true"></i> New Transaction</a>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger text-danger" role="alert">@errorMessage
            <button class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadAsync">Retry</button>
        </div>
    }
    @if (pendingDelete != null)
    {
        <div class="alert alert-warning" role="alert">
            Delete donation @pendingDelete.No?
            <button class="btn btn-sm btn-danger ms-2" disabled="@isBusy" @onclick="DeleteAsync">
                <i class="fas fa-trash" aria-hidden="true"></i> Delete
            </button>
            <button class="btn btn-sm btn-secondary ms-2" disabled="@isBusy" @onclick="() => pendingDelete = null">Cancel</button>
        </div>
    }
    @if (isLoading)
    {
        <div role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading donations...</div>
    }
    else if (donations.Count == 0 && string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-info">No donor transactions recorded.</div>
    }
    else if (donations.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered align-middle">
                <thead>
                    <tr>
                        <th scope="col">Donation No</th>
                        <th scope="col">Donor</th>
                        <th scope="col">Date</th>
                        <th scope="col">Amount</th>
                        <th scope="col">Advantage</th>
                        <th scope="col">Eligible Amount</th>
                        <th scope="col">Purpose</th>
                        <th scope="col">Payment Type</th>
                        <th scope="col">GL Code</th>
                        <th scope="col">Tax Receipt No</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var donation in donations)
                    {
                        <tr @key="donation.Id">
                            <td><a href="/donor-transactions/@donation.Id">@donation.No</a></td>
                            <td>@donation.DonorName</td>
                            <td class="text-nowrap">@donation.DonationDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">$@donation.Amount.ToString("N2")</td>
                            <td class="text-end">$@donation.AdvantageAmount.ToString("N2")</td>
                            <td class="text-end">$@donation.EligibleAmount.ToString("N2")</td>
                            <td>@donation.Purpose</td>
                            <td>@donation.PaymentType</td>
                            <td>@donation.GlAccountCode</td>
                            <td>@donation.TaxReceiptNo</td>
                            <td class="text-nowrap">
                                @if (donation.IsTaxReceiptIssued)
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="/donor-transactions/@donation.Id/receipt"
                                       title="View / print tax receipt" aria-label="View tax receipt @donation.TaxReceiptNo">
                                        <i class="fas fa-print" aria-hidden="true"></i> Receipt
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-success" disabled="@isBusy" title="Issue official tax receipt"
                                            @onclick="() => IssueReceiptAsync(donation)">
                                        <i class="fas fa-file-invoice" aria-hidden="true"></i> Issue tax receipt
                                    </button>
                                }
                                <a class="btn btn-sm btn-secondary ms-1" href="/donor-transactions/@donation.Id" title="Edit donation"
                                   aria-label="Edit donation @donation.No"><i class="fas fa-pen" aria-hidden="true"></i></a>
                                @if (!donation.IsTaxReceiptIssued)
                                {
                                    <button class="btn btn-sm btn-outline-danger ms-1" title="Delete donation" aria-label="Delete donation @donation.No"
                                            disabled="@isBusy" @onclick="() => pendingDelete = donation"><i class="fas fa-trash" aria-hidden="true"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted">Total: @donations.Count donation(s), $@donations.Sum(d => d.Amount).ToString("N2")</p>
    }
</div>

@code {
    [Parameter]
    public int DonorId { get; set; }

    private List<DonationInvoice> donations = new List<DonationInvoice>();
    private DonationInvoice? pendingDelete;
    private string donorName = string.Empty;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isBusy;

    private string ApiUrl => (Configuration["ApiUrl"] ?? Environment.GetEnvironmentVariable("APIURL") ??
"http://localhost:8001/api/").TrimEnd('/') + "/";

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            using (var client = ClientFactory.CreateClient())
            {
                if (DonorId > 0)
                {
                    var donor = await client.GetFromJsonAsync<Dto.Donors.Donor>(ApiUrl + "donors/" + DonorId);
                    donorName = donor?.Name ?? string.Empty;
                }
                else
                    donorName = string.Empty;
                donations = (await client.GetFromJsonAsync<List<DonationInvoice>>(ApiUrl + "donations/DonationInvoices" + (DonorId > 0 ? "?donorId=" + DonorId : ""))
                    ?? new List<DonationInvoice>()).OrderByDescending(d => d.DonationDate).ThenByDescending(d => d.Id).ToList();
                pendingDelete = null;
            }
        }
        catch (HttpRequestException exception)
        {
            errorMessage = exception.StatusCode == System.Net.HttpStatusCode.NotFound
                ? "Donor not found (HTTP 404). Return to Donors and select an existing donor."
                : exception.StatusCode.HasValue
                    ? $"Unable to load donations (HTTP {(int)exception.StatusCode.Value} {exception.StatusCode}). Select Retry."
                    : "Unable to reach the API. Check that the API is running, then select Retry.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "Loading donations timed out. Select Retry.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "The API returned an unreadable donation list. Select Retry.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task IssueReceiptAsync(DonationInvoice donation)
    {
        if (isBusy) return;
        isBusy = true;
        errorMessage = null;
        try
        {
            using (var client = ClientFactory.CreateClient())
            {
                var full = await client.GetFromJsonAsync<DonationInvoice>(ApiUrl + "donations/DonationInvoice?id=" + donation.Id);
                if (full == null)
                {
                    errorMessage = "The donation could not be loaded. Select Retry.";
                    return;
                }
                full.IsTaxReceiptIssued = true;
                using (var response = await client.PostAsJsonAsync(ApiUrl + "donations/UpdateDonationInvoice", full))
                {
                    if (!response.IsSuccessStatusCode)
                    {
                        var details = await response.Content.ReadAsStringAsync();
                        errorMessage = response.StatusCode == System.Net.HttpStatusCode.BadRequest && !string.IsNullOrWhiteSpace(details)
                            ? details.Trim('"')
                            : $"The tax receipt could not be issued (HTTP {(int)response.StatusCode}).";
                        return;
                    }
                }
            }
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "The connection to the API failed while issuing the receipt. Refresh to check whether it was issued before retrying.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "The request timed out. Refresh to check whether the receipt was issued before retrying.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (pendingDelete == null || isBusy) return;
        isBusy = true;
        errorMessage = null;
        try
        {
            using (var client = ClientFactory.CreateClient())
            using (var response = await client.DeleteAsync(ApiUrl + "donations/DeleteDonationInvoice?id=" + pendingDelete.Id))
            {
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = $"Unable to delete this donation (HTTP {(int)response.StatusCode}). Select Retry to refresh the list.";
                    return;
                }
            }
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "The connection to the API failed during deletion. Select Retry to refresh the list.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "The delete request timed out. Select Retry to refresh the list.";
        }
        finally
        {
            isBusy = false;
        }
    }
}
