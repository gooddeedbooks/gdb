@namespace GoodBooks.Donors.Components

<PageTitle>Donor Tax Receipts PDF</PageTitle>

<div class="container-fluid">
    <h1 class="h3 mb-3">Donor Tax Receipts (PDF)</h1>
    <p class="text-muted">Creates one PDF containing every tax receipt issued between the two dates, sorted by donor.</p>
    <form method="get" action="/donor-receipts/pdf" class="col-lg-6" data-enhance="false">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="receipts-from">Start Date</label>
                <input id="receipts-from" name="from" type="date" class="form-control form-control-themed" required value="@DateTime.Today.ToString("yyyy-01-01")" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="receipts-to">End Date</label>
                <input id="receipts-to" name="to" type="date" class="form-control form-control-themed" required value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <button type="submit" class="btn btn-primary mt-3"><i class="fas fa-file-pdf" aria-hidden="true"></i> Generate PDF</button>
    </form>
</div>
