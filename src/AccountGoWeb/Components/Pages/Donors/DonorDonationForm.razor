@namespace GoodBooks.Donors.Components
@using Dto.Donations
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Configuration
@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager

<PageTitle>@(Id.GetValueOrDefault() > 0 ? "Edit Donor Transaction" : "New Donor Transaction")</PageTitle>

<h1 class="h3 mb-3">@(Id.GetValueOrDefault() > 0 ? "Edit Donor Transaction" : "New Donor Transaction")</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger text-danger" role="alert">@errorMessage</div>
}
@if (isLoading)
{
    <div role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading donation...
    </div>
}
else if (isLoaded)
{
    <div class="col-lg-8">
        <EditForm Model="invoice" OnValidSubmit="SaveDonationAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <fieldset disabled="@isSaving">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" for="donation-donor">Donor</label>
                        <InputSelect id="donation-donor" class="form-select form-control-themed"
                                     @bind-Value="invoice.DonorId" disabled="@(invoice.Id > 0)">
                            <option value="0">-- Select Donor --</option>
                            @foreach (var donor in donors)
                            {
                                <option value="@donor.Id">@donor.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage class="text-danger" For="() => invoice.DonorId" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="donation-date">Donation Date</label>
                        <InputDate id="donation-date" class="form-control form-control-themed"
                                   @bind-Value="invoice.DonationDate" />
                        <ValidationMessage class="text-danger" For="() => invoice.DonationDate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="donation-payment-type">Payment Type</label>
                        <InputSelect id="donation-payment-type" class="form-select form-control-themed"
                                     @bind-Value="invoice.PaymentType">
                            <option value="">-- Select Payment Type --</option>
                            <option value="Cash">Cash</option>
                            <option value="Cheque">Cheque</option>
                            <option value="Credit Card">Credit Card</option>
                            <option value="Debit Card">Debit Card</option>
                            <option value="E-Transfer">E-Transfer</option>
                        </InputSelect>
                        <ValidationMessage class="text-danger" For="() => invoice.PaymentType" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="donation-type">Donation Type</label>
                        <select id="donation-type" class="form-select form-control-themed" value="@donationTypeId"
                                @onchange="OnDonationTypeChanged">
                            <option value="0">-- Select Donation Type --</option>
                            @foreach (var type in donationTypes)
                            {
                                <option value="@type.Id">@type.Name@(string.IsNullOrEmpty(type.GlAccountCode) ? "" : " (" + type.GlAccountCode + ")")</option>
                            }
                        </select>
                        <ValidationMessage class="text-danger" For="() => invoice.GlAccountId" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="donation-amount">Amount</label>
                        <InputNumber id="donation-amount" class="form-control form-control-themed"
                                     @bind-Value="invoice.Amount" step="0.01" min="0.01" />
                        <ValidationMessage class="text-danger" For="() => invoice.Amount" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="donation-advantage">Advantage (value of any benefit received by the donor)</label>
                        <InputNumber id="donation-advantage" class="form-control form-control-themed"
                                     @bind-Value="invoice.AdvantageAmount" step="0.01" min="0" />
                        <ValidationMessage class="text-danger" For="() => invoice.AdvantageAmount" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="donation-eligible">Eligible Amount of Gift</label>
                        <input id="donation-eligible" class="form-control form-control-themed" readonly
                               value="@((invoice.Amount - invoice.AdvantageAmount).ToString("F2"))" />
                    </div>
                    <div class="col-12">
                        @if (invoice.Id == 0)
                        {
                            <div class="form-text">A tax receipt is issued automatically when the donor is set to "Issue tax receipt" in Manage Donors.</div>
                        }
                        @if (invoice.Id > 0 && invoice.IsTaxReceiptIssued && !string.IsNullOrEmpty(invoice.TaxReceiptNo))
                        {
                            <div class="mt-2">
                                Receipt # <strong>@invoice.TaxReceiptNo</strong>
                                <a class="btn btn-sm btn-outline-primary ms-2" href="/donor-transactions/@invoice.Id/receipt">
                                    <i class="fas fa-print" aria-hidden="true"></i> View / Print Receipt
                                </a>
                            </div>
                        }
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fas fa-save me-2" aria-hidden="true"></i>@(isSaving ? "Saving..." : "Save")
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="Cancel">
                        <i class="fas fa-times me-2" aria-hidden="true"></i>Cancel
                    </button>
                </div>
            </fieldset>
        </EditForm>
    </div>
}
else
{
    <a class="btn btn-secondary" href="@ReturnUrl">Back to Donor Transactions</a>
}

@code {
    [Parameter]
    public int DonorId { get; set; }

    [Parameter]
    public int? Id { get; set; }

    [Parameter]
    public bool ForceLoad { get; set; }

    private string ReturnUrl => "/donor-transactions";

    private DonationInvoice invoice = new DonationInvoice();
    private List<Dto.Donors.Donor> donors = new List<Dto.Donors.Donor>();
    private List<Dto.DonationTypes.DonationType> donationTypes = new List<Dto.DonationTypes.DonationType>();
    private int donationTypeId;
    private bool isLoading = true;
    private bool isLoaded;
    private bool isSaving;
    private string? errorMessage;

    private string ApiUrl => (Configuration["ApiUrl"] ?? Environment.GetEnvironmentVariable("APIURL") ??
"http://localhost:8001/api/").TrimEnd('/') + "/";

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        isLoaded = false;
        errorMessage = null;
        var loading = "donors";
        try
        {
            donors = await ClientFactory.CreateClient().GetFromJsonAsync<List<Dto.Donors.Donor>>(ApiUrl + "donors") ?? new List<Dto.Donors.Donor>();
            loading = "donation types";
            donationTypes = await ClientFactory.CreateClient().GetFromJsonAsync<List<Dto.DonationTypes.DonationType>>(ApiUrl + "donation-types")
                ?? new List<Dto.DonationTypes.DonationType>();
            loading = "donation";
            if (Id.GetValueOrDefault() > 0)
            {
                var loadedDonation = await ClientFactory.CreateClient().GetFromJsonAsync<DonationInvoice>(ApiUrl + "donations/DonationInvoice?id=" +
Id.GetValueOrDefault());
                if (loadedDonation == null)
                {
                    errorMessage = "The API returned an empty donation. Return to the donor's donations and select an existing record.";
                    return;
                }
                invoice = loadedDonation;
            }
            else
                invoice = new DonationInvoice { DonorId = DonorId };

            donationTypeId = donationTypes.FirstOrDefault(type => type.GlAccountId == invoice.GlAccountId && type.Name == invoice.Purpose)?.Id ?? 0;
            isLoaded = true;
            if (donationTypes.Count == 0)
                errorMessage = "No donation types are available. Add one under Donors > Donation Types before saving a transaction.";
            else if (donors.Count == 0)
                errorMessage = "No donors are available. Add a donor in the Donors module before saving a donation.";
        }
        catch (HttpRequestException exception)
        {
            errorMessage = exception.StatusCode.HasValue
                ? $"Unable to load {loading} (HTTP {(int)exception.StatusCode.Value}). Return to the donor's donations and try again. Contact your administrator if the problem continues."
                : $"Unable to reach the API while loading {loading}. Check the API connection and try again.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = $"Loading {loading} timed out. Return to the donor's donations and try again.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = $"The API returned unreadable {loading} data. Contact your administrator if the problem continues.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnDonationTypeChanged(ChangeEventArgs args)
    {
        int.TryParse(args.Value?.ToString(), out donationTypeId);
        var type = donationTypes.FirstOrDefault(t => t.Id == donationTypeId);
        invoice.GlAccountId = type?.GlAccountId;
        invoice.Purpose = type?.Name;
    }

    private async Task SaveDonationAsync()
    {
        if (isSaving) return;
        isSaving = true;
        errorMessage = null;
        try
        {
            if (invoice.Id == 0 && donors.FirstOrDefault(d => d.Id == invoice.DonorId)?.IssueTaxReceipt == true)
                invoice.IsTaxReceiptIssued = true;
            var endpoint = Id.GetValueOrDefault() > 0 ? "donations/UpdateDonationInvoice" : "donations/CreateDonationInvoice";
            using (var client = ClientFactory.CreateClient())
            using (var response = await client.PostAsJsonAsync(ApiUrl + endpoint, invoice))
            {
                if (!response.IsSuccessStatusCode)
                {
                    if (response.StatusCode == System.Net.HttpStatusCode.BadRequest || response.StatusCode ==
System.Net.HttpStatusCode.UnprocessableEntity)
                    {
                        var details = await response.Content.ReadAsStringAsync();
                        errorMessage = "The API rejected the donation details. Check the donor, amount, payment type and GL code before saving again.";
                        if (response.Content.Headers.ContentType?.MediaType?.Contains("json") == true)
                        {
                            using (var document = System.Text.Json.JsonDocument.Parse(details))
                            {
                                if (document.RootElement.ValueKind == System.Text.Json.JsonValueKind.String)
                                    errorMessage = document.RootElement.GetString();
                            }
                        }
                        else if (!string.IsNullOrWhiteSpace(details))
                            errorMessage = details;
                    }
                    else
                        errorMessage = $"The donation could not be saved (HTTP {(int)response.StatusCode}). Your entered details have been kept. Check the Donations list before retrying.";
                    return;
                }
                NavigationManager.NavigateTo(ReturnUrl, ForceLoad);
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "The connection to the API failed while saving. Your entered details have been kept. Check the Donations list before retrying to avoid a duplicate.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "The save request timed out. Check the Donations list to see whether the save completed before retrying.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "The API returned an unreadable error response. Check the Donations list before retrying and contact your administrator if the problem continues.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo(ReturnUrl, ForceLoad);
    }
}