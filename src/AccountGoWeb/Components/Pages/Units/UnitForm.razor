@namespace GoodBooks.Units.Components
@using System.Net.Http.Json
@using Dto.Inventory
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<PageTitle>@(Id == 0 ? "New Unit" : "Edit Unit")</PageTitle>

<div class="container-fluid">
    <h1 class="h3 mb-3">@(Id == 0 ? "New Unit" : "Edit Unit")</h1>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger text-danger" role="alert">@errorMessage</div>
    }
    @if (isLoading)
    {
        <div role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading unit...</div>
    }
    else if (isLoaded)
    {
        <EditForm @key="editContext" EditContext="editContext" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <fieldset disabled="@isSaving">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="unit-code">Code</label>
                        <InputText id="unit-code" class="form-control form-control-themed"
                                   @bind-Value="model.Code" maxlength="20" />
                        <ValidationMessage class="text-danger" For="() => model.Code" />
                    </div>
                </div>
                <div class="row g-3 mt-0">
                    <div class="col-md-6">
                        <label class="form-label" for="unit-description">Description</label>
                        <InputText id="unit-description" class="form-control form-control-themed"
                                   @bind-Value="model.Description" maxlength="100" />
                        <ValidationMessage class="text-danger" For="() => model.Description" />
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save" aria-hidden="true"></i> Save
                    </button>
                    <a class="btn btn-secondary ms-2" href="/units">Cancel</a>
                </div>
            </fieldset>
        </EditForm>
    }
    else
    {
        <a class="btn btn-secondary" href="/units">Back to Units of Measure</a>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    [Parameter]
    public bool ForceLoad { get; set; }

    private Unit model = new Unit();
    private EditContext editContext = new EditContext(new Unit());
    private bool isLoading = true;
    private bool isLoaded;
    private bool isSaving;
    private string? errorMessage;

    private string ApiUrl => (Configuration["ApiUrl"] ?? Environment.GetEnvironmentVariable("APIURL") ??
        "http://localhost:8001/api/").TrimEnd('/') + "/units";

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        isLoaded = false;
        errorMessage = null;
        model = new Unit();
        try
        {
            if (Id != 0)
            {
                using var client = ClientFactory.CreateClient();
                using var response = await client.GetAsync(ApiUrl + "/" + Id);
                if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
                {
                    errorMessage = "Unit not found (HTTP 404). It may have been deleted.";
                    return;
                }
                response.EnsureSuccessStatusCode();
                model = await response.Content.ReadFromJsonAsync<Unit>()
                    ?? throw new System.Text.Json.JsonException("The API returned an empty unit record.");
            }
            editContext = new EditContext(model);
            isLoaded = true;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = exception.StatusCode.HasValue
                ? $"Unable to load this unit (HTTP {(int)exception.StatusCode.Value} {exception.StatusCode})."
                : "Unable to reach the API. Check that the API is running.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "Loading the unit timed out.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "The API returned an unreadable unit record.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (isSaving) return;
        isSaving = true;
        errorMessage = null;
        try
        {
            using var client = ClientFactory.CreateClient();
            using var response = Id == 0
                ? await client.PostAsJsonAsync(ApiUrl, model)
                : await client.PutAsJsonAsync(ApiUrl + "/" + Id, model);
            if (!response.IsSuccessStatusCode)
            {
                if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    var problem = await response.Content.ReadFromJsonAsync<Microsoft.AspNetCore.Mvc.ValidationProblemDetails>();
                    errorMessage = problem != null && problem.Errors.Count > 0
                        ? string.Join(" ", problem.Errors.Values.SelectMany(messages => messages))
                        : "The API rejected the unit (HTTP 400). Check the code and description.";
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
                    errorMessage = "This unit no longer exists (HTTP 404). Your changes were not saved.";
                else
                    errorMessage = $"The API could not save the unit (HTTP {(int)response.StatusCode} {response.StatusCode}). Your entered details have been kept.";
                return;
            }
            Navigation.NavigateTo("/units", ForceLoad);
        }
        catch (HttpRequestException)
        {
            errorMessage = "The connection to the API failed while saving. Your entered details have been kept. Check the units list before retrying.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "The save request timed out. Your entered details have been kept. Check the units list before retrying.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "The API returned an unreadable error response. Your entered details have been kept.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
