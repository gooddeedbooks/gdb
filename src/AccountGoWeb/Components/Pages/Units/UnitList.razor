@namespace GoodBooks.Units.Components
@using System.Net.Http.Json
@using Dto.Inventory
@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration

<PageTitle>Units of Measure</PageTitle>

<div class="container-fluid">
    <h1 class="h3 mb-3">Units of Measure</h1>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <a class="btn btn-primary" href="/units/new"><i class="fas fa-plus" aria-hidden="true"></i> New Unit</a>
        <input class="form-control form-control-themed w-auto mw-100" type="search" aria-label="Search units"
               placeholder="Search units" @bind="search" @bind:event="oninput" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger text-danger" role="alert">@errorMessage
            <button class="btn btn-sm btn-outline-danger ms-2" disabled="@isDeleting" @onclick="LoadAsync">Retry</button>
        </div>
    }
    @if (pendingDelete != null)
    {
        <div class="alert alert-warning" role="alert">
            Delete @pendingDelete.Description (@pendingDelete.Code)?
            <button class="btn btn-sm btn-danger ms-2" disabled="@isDeleting" @onclick="DeleteAsync">
                <i class="fas fa-trash" aria-hidden="true"></i> Delete
            </button>
            <button class="btn btn-sm btn-secondary ms-2" disabled="@isDeleting" @onclick="CancelDelete">Cancel</button>
        </div>
    }
    @if (isLoading)
    {
        <div role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading units...</div>
    }
    else if (items.Count == 0 && string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-info">No units found.</div>
    }
    else if (items.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered align-middle">
                <thead>
                    <tr>
                        <th scope="col">Code</th>
                        <th scope="col">Description <button class="btn btn-sm btn-link" title="Sort by description"
                            aria-label="Sort by description" @onclick="ToggleSort"><i class="fas fa-sort" aria-hidden="true"></i></button></th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Filtered)
                    {
                        <tr @key="item.Id">
                            <td><a href="/units/@item.Id">@item.Code</a></td>
                            <td>@item.Description</td>
                            <td class="text-nowrap">
                                <a class="btn btn-sm btn-secondary" href="/units/@item.Id" title="Edit unit"
                                   aria-label="Edit @item.Description"><i class="fas fa-pen" aria-hidden="true"></i></a>
                                <button class="btn btn-sm btn-outline-danger ms-1" title="Delete unit"
                                        aria-label="Delete @item.Description" disabled="@isDeleting"
                                        @onclick="() => pendingDelete = item"><i class="fas fa-trash" aria-hidden="true"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Filtered.Any())
        {
            <p class="text-muted">No matching units.</p>
        }
        <p class="text-muted">Total: @Filtered.Count() unit(s)</p>
    }
</div>

@code {
    private List<Unit> items = new List<Unit>();
    private Unit? pendingDelete;
    private string search = string.Empty;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isDeleting;
    private bool sortAscending = true;

    private string ApiUrl => (Configuration["ApiUrl"] ?? Environment.GetEnvironmentVariable("APIURL") ??
        "http://localhost:8001/api/").TrimEnd('/') + "/units";

    private IEnumerable<Unit> Filtered
    {
        get
        {
            var filtered = items.Where(item => string.IsNullOrWhiteSpace(search) ||
                (item.Code + " " + item.Description).IndexOf(search, StringComparison.OrdinalIgnoreCase) >= 0);
            return sortAscending ? filtered.OrderBy(item => item.Description) : filtered.OrderByDescending(item => item.Description);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            using var client = ClientFactory.CreateClient();
            items = await client.GetFromJsonAsync<List<Unit>>(ApiUrl)
                ?? throw new System.Text.Json.JsonException("The API returned an empty unit list.");
            pendingDelete = null;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = exception.StatusCode.HasValue
                ? $"Unable to load units (HTTP {(int)exception.StatusCode.Value} {exception.StatusCode}). Retry loading the list."
                : "Unable to reach the API. Check that the API is running, then select Retry.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "Loading units timed out. Select Retry to load the list again.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "The API returned an unreadable unit list. Select Retry.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleSort() => sortAscending = !sortAscending;
    private void CancelDelete() => pendingDelete = null;

    private async Task DeleteAsync()
    {
        if (pendingDelete == null || isDeleting) return;
        isDeleting = true;
        errorMessage = null;
        try
        {
            using var client = ClientFactory.CreateClient();
            using var response = await client.DeleteAsync(ApiUrl + "/" + pendingDelete.Id);
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var problem = await response.Content.ReadFromJsonAsync<Microsoft.AspNetCore.Mvc.ProblemDetails>();
                errorMessage = problem?.Detail ?? "This unit is in use and cannot be deleted.";
                pendingDelete = null;
                return;
            }
            response.EnsureSuccessStatusCode();
            items.Remove(pendingDelete);
            pendingDelete = null;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = exception.StatusCode.HasValue
                ? $"Unable to delete this unit (HTTP {(int)exception.StatusCode.Value} {exception.StatusCode}). Select Retry to refresh the list."
                : "The connection to the API failed during deletion. Select Retry to refresh the list and check whether it was deleted.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "The delete request timed out. Select Retry to refresh the list and check whether it was deleted.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "The API returned an unreadable error response. Select Retry to refresh the list.";
        }
        finally
        {
            isDeleting = false;
        }
    }
}
