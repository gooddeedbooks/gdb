@using System.Globalization
@using SalesReceiptDto = Dto.Sales.SalesReceipt
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation

<div class="customer-payments-page">
    <div class="view-switch btn-group mb-4" role="tablist" aria-label="Customer payment views">
        <button type="button" role="tab" aria-selected="@(activeTab == InvoicesTab ? "true" : "false")"
                class="btn btn-lg @(activeTab == InvoicesTab ? "btn-primary" : "btn-outline-primary")"
                @onclick="() => SelectTab(InvoicesTab)">
            <i class="fas fa-file-invoice-dollar me-2" aria-hidden="true"></i>Outstanding Invoices
            @if (outstandingInvoiceCount > 0)
            {
                <span class="badge rounded-pill bg-danger ms-2" aria-label="@outstandingInvoiceCount outstanding invoices">@outstandingInvoiceCount</span>
            }
        </button>
        <button type="button" role="tab" aria-selected="@(activeTab == PaymentsTab ? "true" : "false")"
                class="btn btn-lg @(activeTab == PaymentsTab ? "btn-primary" : "btn-outline-primary")"
                @onclick="() => SelectTab(PaymentsTab)">
            <i class="fas fa-hand-holding-usd me-2" aria-hidden="true"></i>Payments Received
            @if (salesReceipts.Count > 0)
            {
                <span class="badge rounded-pill bg-success ms-2" aria-label="@salesReceipts.Count payments received">@salesReceipts.Count</span>
            }
        </button>
    </div>

    @if (activeTab == InvoicesTab)
    {
        <SalesOrderInvoices PaymentMode="true" />
    }
    else
    {
        <div class="toolbar-actions mb-3">
            <a class="btn btn-primary" href="/Sales/NewCustomerPayment">
                <i class="fas fa-plus" aria-hidden="true"></i> New Customer Payment
            </a>
            <button class="btn btn-primary" type="button" @onclick="ViewSelectedReceipt" disabled="@(selectedReceipt is null)">
                <i class="fas fa-edit" aria-hidden="true"></i> View
            </button>
            <button class="btn btn-primary" type="button" @onclick="AllocateSelectedReceipt"
                    disabled="@(selectedReceipt is null || selectedReceipt.RemainingAmountToAllocate <= 0)"
                    title="Apply the unallocated amount of the selected payment to invoices">
                <i class="fas fa-tasks" aria-hidden="true"></i> Allocate
            </button>
        </div>

        @if (isLoading)
        {
            <div class="empty-state">Loading payments...</div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        else
        {
            <div class="payment-filters">
                <select class="form-select form-control-themed" aria-label="Filter by customer"
                        @bind="customerFilter" @bind:after="ClearHiddenSelection">
                    <option value="0">All customers</option>
                    @foreach (var customer in salesReceipts.GroupBy(x => x.CustomerId).Select(g => g.First()).OrderBy(x => x.CustomerName))
                    {
                        <option value="@customer.CustomerId">@customer.CustomerName</option>
                    }
                </select>
                <span class="payment-summary">
                    @FilteredReceipts.Count() payment(s) — Received @FormatCurrency(FilteredReceipts.Sum(x => x.Amount))
                </span>
            </div>

            @if (!FilteredReceipts.Any())
            {
                <div class="empty-state">No payments received.</div>
            }
            else
            {
                <div class="table-shell">
                    <table class="table payments-table">
                        <thead>
                            <tr>
                                <th @onclick='() => SortBy(nameof(SalesReceiptDto.ReceiptNo))'>Payment No @GetSortIndicator(nameof(SalesReceiptDto.ReceiptNo))</th>
                                <th @onclick='() => SortBy(nameof(SalesReceiptDto.CustomerName))'>Customer Name @GetSortIndicator(nameof(SalesReceiptDto.CustomerName))</th>
                                <th @onclick='() => SortBy(nameof(SalesReceiptDto.ReceiptDate))'>Payment Date @GetSortIndicator(nameof(SalesReceiptDto.ReceiptDate))</th>
                                <th class="text-end" @onclick='() => SortBy(nameof(SalesReceiptDto.Amount))'>Amount @GetSortIndicator(nameof(SalesReceiptDto.Amount))</th>
                                <th class="text-end">Left to Allocate</th>
                                <th>Applied To</th>
                                <th>Method</th>
                                <th>Reference #</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var receipt in SortedReceipts)
                            {
                                <tr class="clickable-row @(selectedReceipt?.Id == receipt.Id ? "selected-row" : "")"
                                    @key="receipt.Id"
                                    @onclick="() => SelectReceipt(receipt)"
                                    @ondblclick="() => OpenReceipt(receipt)">
                                    <td>@receipt.ReceiptNo</td>
                                    <td>@receipt.CustomerName</td>
                                    <td>@receipt.ReceiptDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                                    <td class="text-end">@FormatCurrency(receipt.Amount)</td>
                                    <td class="text-end">@FormatCurrency(receipt.RemainingAmountToAllocate)</td>
                                    <td>@DisplayText(receipt.AppliedToInvoices)</td>
                                    <td>@DisplayText(receipt.PaymentMethod)</td>
                                    <td>@DisplayText(receipt.ReferenceNo)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3">Totals</td>
                                <td class="text-end">@FormatCurrency(FilteredReceipts.Sum(x => x.Amount))</td>
                                <td class="text-end">@FormatCurrency(FilteredReceipts.Sum(x => x.RemainingAmountToAllocate))</td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        }
    }
</div>

@code {
    private const string InvoicesTab = "invoices";
    private const string PaymentsTab = "payments";

    // Selected tab; "?tab=payments" opens the payments received list.
    private string activeTab = InvoicesTab;

    private List<SalesReceiptDto> salesReceipts = new();
    private SalesReceiptDto? selectedReceipt;
    private bool isLoading = true;
    private string? errorMessage;
    private int outstandingInvoiceCount;

    // 0 shows payments from all customers.
    private int customerFilter;

    private string sortBy = nameof(SalesReceiptDto.ReceiptDate);
    private bool sortAscending;
    private string baseApiUrl = string.Empty;

    private IEnumerable<SalesReceiptDto> FilteredReceipts =>
        customerFilter == 0 ? salesReceipts : salesReceipts.Where(x => x.CustomerId == customerFilter);

    private IEnumerable<SalesReceiptDto> SortedReceipts => sortBy switch
    {
        nameof(SalesReceiptDto.ReceiptNo) => Order(x => int.TryParse(x.ReceiptNo, out var no) ? no : int.MaxValue),
        nameof(SalesReceiptDto.CustomerName) => Order(x => x.CustomerName ?? string.Empty),
        nameof(SalesReceiptDto.Amount) => Order(x => x.Amount),
        _ => Order(x => x.ReceiptDate)
    };

    /// <summary>Reads the requested tab and loads payments plus the outstanding invoice count.</summary>
    protected override async Task OnInitializedAsync()
    {
        baseApiUrl = Environment.GetEnvironmentVariable("APIURL") ?? "http://localhost:8001/api/";
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        if (query.TryGetValue("tab", out var tab) && string.Equals(tab.ToString(), PaymentsTab, StringComparison.OrdinalIgnoreCase))
            activeTab = PaymentsTab;

        await Task.WhenAll(LoadSalesReceipts(), LoadOutstandingInvoiceCount());
    }

    /// <summary>Loads all customer payments.</summary>
    private async Task LoadSalesReceipts()
    {
        try
        {
            var client = ClientFactory.CreateClient();
            client.Timeout = TimeSpan.FromSeconds(60);
            var response = await client.GetAsync($"{baseApiUrl}sales/salesreceipts");
            if (response.IsSuccessStatusCode)
                salesReceipts = await response.Content.ReadFromJsonAsync<List<SalesReceiptDto>>() ?? new();
            else
                errorMessage = $"Failed to load customer payments. Status: {response.StatusCode}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading customer payments: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>Loads the unpaid invoice count for the tab badge; failures leave the badge hidden.</summary>
    private async Task LoadOutstandingInvoiceCount()
    {
        try
        {
            var client = ClientFactory.CreateClient();
            var invoices = await client.GetFromJsonAsync<List<Dto.Sales.OutstandingInvoice>>($"{baseApiUrl}sales/OutstandingInvoices");
            outstandingInvoiceCount = invoices?.Count ?? 0;
        }
        catch (HttpRequestException)
        {
        }
        catch (System.Text.Json.JsonException)
        {
        }
    }

    private void SelectTab(string tab)
    {
        activeTab = tab;
        Navigation.NavigateTo(tab == PaymentsTab ? "/Sales/CustomerPayments?tab=payments" : "/Sales/CustomerPayments", replace: true);
    }

    private IEnumerable<SalesReceiptDto> Order<TKey>(Func<SalesReceiptDto, TKey> key) =>
        sortAscending ? FilteredReceipts.OrderBy(key) : FilteredReceipts.OrderByDescending(key);

    private void SortBy(string column)
    {
        sortAscending = sortBy != column || !sortAscending;
        sortBy = column;
    }

    private string GetSortIndicator(string column) =>
        sortBy != column ? string.Empty : sortAscending ? "↑" : "↓";

    // Drops the selection when the customer filter hides the selected payment.
    private void ClearHiddenSelection()
    {
        if (selectedReceipt is not null && !FilteredReceipts.Any(x => x.Id == selectedReceipt.Id))
            selectedReceipt = null;
    }

    private void SelectReceipt(SalesReceiptDto receipt) =>
        selectedReceipt = selectedReceipt?.Id == receipt.Id ? null : receipt;

    private void OpenReceipt(SalesReceiptDto receipt) =>
        Navigation.NavigateTo($"/Sales/CustomerPayment?id={receipt.Id}", forceLoad: true);

    private void ViewSelectedReceipt()
    {
        if (selectedReceipt is not null)
            OpenReceipt(selectedReceipt);
    }

    private void AllocateSelectedReceipt()
    {
        if (selectedReceipt is not null)
            Navigation.NavigateTo($"/Sales/Allocate/{selectedReceipt.Id}", forceLoad: true);
    }

    private static string FormatCurrency(decimal value) =>
        "$" + value.ToString("N2", CultureInfo.InvariantCulture);

    private static string DisplayText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;
}
