@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Globalization

<style>
    label,
    h5 {
        color: var(--bs-white, #fff) !important;
    }

    .invoice-totals {
        width: min(100%, 26rem);
    }
</style>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-0">@PageHeading</h1>
        </div>
        <div class="col text-end">
            <a href="@ReturnUrl" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left"></i>
                @(IsFromOrder ? "Back to Orders" : "Back to Invoices")
            </a>
        </div>
    </div>

    @if (loading)
    {
        <p><em>Loading invoice...</em></p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Error:</strong> @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        @if (isPosted)
        {
            <div class="alert alert-warning" role="status">
                This invoice is posted to the general ledger and cannot be edited.
            </div>
        }

        <div class="row">
            <div class="col-md-10">
                <div class="card">
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label"><strong>Invoice ID</strong></label>
                                <input type="number" min="1" step="1" class="form-control form-control-themed" @bind="invoiceNumber" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><strong>Invoice Date</strong></label>
                                <input type="date" class="form-control form-control-themed" @bind="invoiceDate" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label"><strong>Customer</strong></label>
                                <select class="form-control form-control-themed" @bind="customerId" @bind:after="RecalculateAsync" disabled="@IsFromOrder">
                                    <option value="0">-- Select Customer --</option>
                                    @foreach (var customer in customers)
                                    {
                                        <option value="@customer.id">@customer.name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><strong>Payment Term</strong></label>
                                <select class="form-control form-control-themed" @bind="paymentTermId">
                                    <option value="0">-- Select Payment Term --</option>
                                    @foreach (var term in paymentTerms)
                                    {
                                        <option value="@term.id">@term.description</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <h5 class="mt-4 mb-3">Line Items</h5>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered table-dark">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th>Quantity</th>
                                        <th>Price per Unit</th>
                                        <th>Discount (%)</th>
                                        <th>Unit</th>
                                        <th>Amount</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (lineItems != null && lineItems.Count > 0)
                                    {
                                        @foreach (var line in lineItems)
                                        {
                                            <tr @key="line">
                                                <td>
                                                    <select class="form-control form-control-sm form-control-themed"
                                                            @bind="line.ItemId" @bind:after="RecalculateAsync" disabled="@(IsFromOrder && line.Id > 0)">
                                                        <option value="0">-- Select Item --</option>
                                                        @foreach (var item in items)
                                                        {
                                                            <option value="@item.id">@item.description</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control form-control-sm form-control-themed"
                                                           @bind="line.Quantity" @bind:after="RecalculateAsync" step="0.01" min="0.01" placeholder="1" />
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control form-control-sm form-control-themed"
                                                           @bind="line.Amount" @bind:after="RecalculateAsync" step="0.01" placeholder="0.00" />
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control form-control-sm form-control-themed"
                                                           @bind="line.Discount" @bind:after="RecalculateAsync" step="0.01" placeholder="0.00" />
                                                </td>
                                                <td>
                                                    <select class="form-control form-control-sm form-control-themed"
                                                            @bind="line.MeasurementId" disabled="@(IsFromOrder && line.Id > 0)">
                                                        <option value="0">-- Select Unit --</option>
                                                        @foreach (var measurement in measurements)
                                                        {
                                                            <option value="@measurement.id">@measurement.description</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control form-control-sm form-control-themed"
                                                           value="@FormatCurrency(GetLineAmount(line))" readonly aria-label="Line amount" />
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                                            aria-label="Delete line item" title="Delete line item" disabled="@isSaving"
                                                            @onclick="() => RemoveLineItem(line)">
                                                        <i class="fas fa-trash" aria-hidden="true"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mt-3">
                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddLineItem" disabled="@isSaving">
                                <i class="fas fa-plus"></i>
                                Add Row
                            </button>
                            <div class="invoice-totals">
                                <div class="row g-2 align-items-center mb-2">
                                    <label class="col-6 col-form-label text-end" for="invoice-total"><strong>Total Amount</strong></label>
                                    <div class="col-6">
                                        <input id="invoice-total" type="text" class="form-control form-control-themed"
                                               value="@FormatCurrency(totalAmount)" readonly />
                                    </div>
                                </div>
                                <div class="row g-2 align-items-center mb-2">
                                    <label class="col-6 col-form-label text-end" for="invoice-shipping"><strong>Shipping</strong></label>
                                    <div class="col-6">
                                        <input id="invoice-shipping" type="number" min="0" step="0.01" class="form-control form-control-themed"
                                               @bind="shipping" @bind:after="RecalculateAsync" disabled="@isSaving" />
                                    </div>
                                </div>
                                <div class="row g-2 align-items-center mb-2">
                                    <label class="col-6 col-form-label text-end" for="invoice-tax"
                                           title="Tax is added to the discounted item subtotal plus shipping using the customer's tax group.">
                                        <strong>@TaxLabel</strong>
                                    </label>
                                    <div class="col-6">
                                        <input id="invoice-tax" type="text" class="form-control form-control-themed"
                                               value="@FormatCurrency(taxAmount)" readonly />
                                    </div>
                                </div>
                                <div class="row g-2 align-items-center">
                                    <label class="col-6 col-form-label text-end" for="invoice-grand-total"><strong>Total Invoice</strong></label>
                                    <div class="col-6">
                                        <input id="invoice-grand-total" type="text" class="form-control form-control-themed"
                                               value="@FormatCurrency(TotalInvoice)" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <button class="btn btn-primary btn-sm" @onclick="SaveSalesInvoice" disabled="@(isSaving || !isLoaded || isPosted || isCalculatingTax || taxCalculationFailed)">Save</button>
                    <a href="@ReturnUrl" class="btn btn-secondary btn-sm ms-2">Close</a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private class LineItem
    {
        public int Id { get; set; } = 0; // SalesOrderLine.Id when creating from order
        public int? ItemId { get; set; } = 0;
        public decimal? Quantity { get; set; } = 1;
        public decimal? Amount { get; set; }
        public decimal? Discount { get; set; }
        public int? MeasurementId { get; set; } = 0;
    }

    private class Customer
    {
        public int id { get; set; }
        public string name { get; set; } = "";
    }

    private class Item
    {
        public int id { get; set; }
        public string description { get; set; } = "";
    }

    private class PaymentTerm
    {
        public int id { get; set; }
        public string description { get; set; } = "";
    }

    private class Measurement
    {
        public int id { get; set; }
        public string description { get; set; } = "";
    }

    [Parameter]
    [SupplyParameterFromQuery(Name = "id")]
    public int Id { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "orderId")]
    public int? OrderId { get; set; }

    [Inject]
    private IHttpClientFactory ClientFactory { get; set; } = null!;

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    private bool loading = true;
    private bool isSaving;
    private bool isLoaded;
    private bool IsFromOrder => OrderId.GetValueOrDefault() > 0;
    private bool isPosted;
    private bool IsEditing => !IsFromOrder && Id > 0;
    private string PageHeading => IsEditing ? "Edit Invoice" : "New Invoice";
    private string ReturnUrl => IsFromOrder ? "/Sales/SalesOrders" : "/Sales/SalesOrders?tab=invoices";
    private string? errorMessage = null;

    private int invoiceId = 0;
    private long invoiceNumber;
    private DateTime invoiceDate = DateTime.Now;
    private int customerId = 0;
    private int paymentTermId = 0;
    private decimal totalAmount = 0;
    private List<LineItem> lineItems = new();

    private decimal shipping;
    private decimal taxAmount;
    private bool isCalculatingTax;
    private bool taxCalculationFailed;
    private IList<decimal> taxRates = new List<decimal>();
    private string TaxLabel => "Tax " +
        (taxRates.Count == 0 ? "0%" : string.Join(" + ", taxRates.Select(rate => rate.ToString("0.###", CultureInfo.InvariantCulture) + "%")));
    private int taxRequestVersion;
    private decimal TotalInvoice => totalAmount + shipping + taxAmount;

    private static string FormatCurrency(decimal value) => "$" + value.ToString("N2", CultureInfo.InvariantCulture);

    private static decimal GetLineAmount(LineItem line)
    {
        var total = (line.Quantity ?? 0) * (line.Amount ?? 0);
        return total - ((line.Discount ?? 0) / 100) * total;
    }

    private List<Customer> customers = new();
    private List<Item> items = new();
    private List<PaymentTerm> paymentTerms = new();
    private List<Measurement> measurements = new();

    protected override async Task OnInitializedAsync()
    {
        // Use OrderId if provided, otherwise use Id
        var finalId = OrderId ?? Id;

        await LoadCustomers();
        await LoadItems();
        await LoadPaymentTerms();
        await LoadMeasurements();
        await LoadInvoiceData(finalId);
        await LoadTaxAsync();
        if (isLoaded && invoiceId == 0)
        {
            try
            {
                var apiurl = Environment.GetEnvironmentVariable("APIURL") ?? "http://localhost:8001/api/";
                using var client = ClientFactory.CreateClient();
                invoiceNumber = await client.GetFromJsonAsync<long>($"{apiurl}sales/NextInvoiceNumber");
            }
            catch (HttpRequestException)
            {
                isLoaded = false;
                errorMessage = "Unable to generate an invoice number. Reload the page before saving.";
            }
            catch (System.Text.Json.JsonException)
            {
                isLoaded = false;
                errorMessage = "The API returned an invalid invoice number. Reload the page before saving.";
            }
            catch (TaskCanceledException)
            {
                isLoaded = false;
                errorMessage = "Generating an invoice number timed out. Reload the page before saving.";
            }
        }
    }

    private async Task LoadCustomers()
    {
        try
        {
            string apiurl = System.Environment.GetEnvironmentVariable("APIURL") ?? "http://localhost:8001/api/";
            var client = ClientFactory.CreateClient();
            var response = await client.GetAsync($"{apiurl}sales/customers");

            if (response.IsSuccessStatusCode)
            {
                var responseString = await response.Content.ReadAsStringAsync();
                customers = JsonSerializer.Deserialize<List<Customer>>(responseString) ?? new List<Customer>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading customers: {ex.Message}";
        }
    }

    private async Task LoadItems()
    {
        try
        {
            string apiurl = System.Environment.GetEnvironmentVariable("APIURL") ?? "http://localhost:8001/api/";
            var client = ClientFactory.CreateClient();
            var response = await client.GetAsync($"{apiurl}inventory/items");

            if (response.IsSuccessStatusCode)
            {
                var responseString = await response.Content.ReadAsStringAsync();
                items = JsonSerializer.Deserialize<List<Item>>(responseString) ?? new List<Item>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading items: {ex.Message}";
        }
    }

    private async Task LoadPaymentTerms()
    {
        try
        {
            string apiurl = System.Environment.GetEnvironmentVariable("APIURL") ?? "http://localhost:8001/api/";
            var client = ClientFactory.CreateClient();
            var response = await client.GetAsync($"{apiurl}common/paymentterms");

            if (response.IsSuccessStatusCode)
            {
                var responseString = await response.Content.ReadAsStringAsync();
                paymentTerms = JsonSerializer.Deserialize<List<PaymentTerm>>(responseString) ?? new List<PaymentTerm>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading payment terms: {ex.Message}";
        }
    }

    private async Task LoadMeasurements()
    {
        try
        {
            string apiurl = System.Environment.GetEnvironmentVariable("APIURL") ?? "http://localhost:8001/api/";
            var client = ClientFactory.CreateClient();
            var response = await client.GetAsync($"{apiurl}common/measurements");

            if (response.IsSuccessStatusCode)
            {
                var responseString = await response.Content.ReadAsStringAsync();
                measurements = JsonSerializer.Deserialize<List<Measurement>>(responseString) ?? new List<Measurement>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading units: {ex.Message}";
        }
    }

    private async Task LoadInvoiceData(int saleOrderId)
    {
        try
        {
            // If saleOrderId is 0, we're creating a brand new invoice, no API call needed
            if (saleOrderId == 0)
            {
                lineItems.Add(new LineItem { ItemId = 0, Quantity = 1, Amount = null, Discount = null, MeasurementId = 0 });
                isLoaded = true;
                return;
            }

            string apiurl = System.Environment.GetEnvironmentVariable("APIURL") ?? "http://localhost:8001/api/";
            var client = ClientFactory.CreateClient();

            // If we have an orderId, load from the sales order instead
            string endpoint = OrderId.HasValue && OrderId.Value > 0
            ? $"{apiurl}sales/SalesOrder?id={saleOrderId}" // Load from order
            : $"{apiurl}sales/SalesInvoice?id={saleOrderId}"; // Load existing invoice

            var response = await client.GetAsync(endpoint);

            if (response.IsSuccessStatusCode)
            {
                var responseString = await response.Content.ReadAsStringAsync();
                var invoiceData = JsonSerializer.Deserialize<JsonElement>(responseString, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

                if (invoiceData.ValueKind == JsonValueKind.Object)
                {
                    // Parse invoice/order data
                    if (invoiceData.TryGetProperty("id", out var idElem))
                        invoiceId = IsFromOrder ? 0 : idElem.GetInt32();
                    if (!IsFromOrder && invoiceData.TryGetProperty("no", out var numberElem))
                        long.TryParse(numberElem.GetString(), out invoiceNumber);

                    if (invoiceData.TryGetProperty("customerId", out var custElem))
                        customerId = custElem.GetInt32();

                    // For orders, use orderDate; for invoices, use invoiceDate
                    if (invoiceData.TryGetProperty("invoiceDate", out var invDateElem))
                    {
                        if (DateTime.TryParse(invDateElem.GetString(), out var date))
                            invoiceDate = date;
                    }

                    if (invoiceData.TryGetProperty("paymentTermId", out var termElem))
                    {
                        if (termElem.ValueKind == JsonValueKind.Number)
                            paymentTermId = termElem.GetInt32();
                        else if (termElem.ValueKind == JsonValueKind.Null)
                            paymentTermId = 0;
                    }

                    if (!IsFromOrder)
                    {
                        shipping = GetJsonDecimal(invoiceData, "shipping") ?? 0;
                        isPosted = invoiceData.TryGetProperty("posted", out var postedElem) &&
                            postedElem.ValueKind == JsonValueKind.True;
                    }

                    // Parse line items - works for both orders and invoices
                    var linesProperty = IsFromOrder ? "salesOrderLines" : "salesInvoiceLines";
                    if (invoiceData.TryGetProperty(linesProperty, out var linesElem) && linesElem.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var lineElem in linesElem.EnumerateArray())
                        {
                            var quantity = GetJsonDecimal(lineElem, IsFromOrder ? "remainingQtyToInvoice" : "quantity");
                            if (IsFromOrder && quantity.GetValueOrDefault() <= 0) continue;
                            var line = new LineItem
                            {
                                Id = GetJsonInt(lineElem, "id") ?? 0, // Capture the order line ID!
                                ItemId = GetJsonInt(lineElem, "itemId"),
                                Quantity = quantity,
                                Amount = GetJsonDecimal(lineElem, "amount"),
                                Discount = GetJsonDecimal(lineElem, "discount"),
                                MeasurementId = GetJsonInt(lineElem, "measurementId")
                            };
                            lineItems.Add(line);
                        }
                    }

                    CalculateTotalAmount();
                    isLoaded = !IsFromOrder || lineItems.Count > 0;
                    if (!isLoaded)
                        errorMessage = "This sales order has no remaining quantities to invoice.";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to load data. Status: {response.StatusCode}. Details: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private int? GetJsonInt(JsonElement elem, string propName)
    {
        if (elem.TryGetProperty(propName, out var prop))
        {
            if (prop.ValueKind == JsonValueKind.Number && prop.TryGetInt32(out var val))
                return val;
        }
        return null;
    }

    private decimal? GetJsonDecimal(JsonElement elem, string propName)
    {
        if (elem.TryGetProperty(propName, out var prop))
        {
            if (prop.ValueKind == JsonValueKind.Number && prop.TryGetDecimal(out var val))
                return val;
        }
        return null;
    }

    private void CalculateTotalAmount()
    {
        totalAmount = lineItems.Sum(GetLineAmount);
    }

    private async Task RecalculateAsync()
    {
        CalculateTotalAmount();
        await LoadTaxAsync();
    }

    private async Task LoadTaxAsync()
    {
        var version = ++taxRequestVersion;
        taxCalculationFailed = false;
        var lines = lineItems
            .Where(line => line.ItemId.GetValueOrDefault() > 0 && line.Quantity.GetValueOrDefault() > 0 && line.Amount.GetValueOrDefault() > 0)
            .Select(line => new
            {
                ItemId = line.ItemId!.Value,
                Quantity = line.Quantity!.Value,
                Amount = line.Amount!.Value,
                Discount = line.Discount ?? 0
            }).ToList();

        if (customerId <= 0)
        {
            isCalculatingTax = false;
            taxAmount = 0;
            taxRates.Clear();
            return;
        }

        try
        {
            isCalculatingTax = true;
            var apiurl = Environment.GetEnvironmentVariable("APIURL") ?? "http://localhost:8001/api/";
            using var client = ClientFactory.CreateClient();
            var response = await client.PostAsJsonAsync($"{apiurl}sales/CalculateInvoiceTax",
                new { CustomerId = customerId, Shipping = shipping, Lines = lines });
            response.EnsureSuccessStatusCode();
            var tax = await response.Content.ReadFromJsonAsync<Dto.Sales.InvoiceTaxResult>();
            if (tax == null)
                throw new System.Text.Json.JsonException("The invoice tax response was empty.");
            if (version == taxRequestVersion)
            {
                taxAmount = tax.Amount;
                taxRates = tax.Rates;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException)
        {
            if (version == taxRequestVersion)
            {
                taxCalculationFailed = true;
                errorMessage = "Unable to calculate tax for this customer.";
            }
        }
        finally
        {
            if (version == taxRequestVersion)
                isCalculatingTax = false;
        }
    }

    private void AddLineItem()
    {
        lineItems.Add(new LineItem { ItemId = 0, Quantity = 1, Amount = null, Discount = null, MeasurementId = 0 });
        StateHasChanged();
    }

    private async Task RemoveLineItem(LineItem line)
    {
        lineItems.Remove(line);
        await RecalculateAsync();
    }

    private async Task SaveSalesInvoice()
    {
        if (isSaving || !isLoaded || isPosted || isCalculatingTax || taxCalculationFailed) return;
        try
        {
            if (invoiceNumber <= 0)
            {
                errorMessage = "Invoice ID must be a positive whole number.";
                return;
            }
            if (shipping < 0)
            {
                errorMessage = "Shipping cannot be negative.";
                return;
            }
            // Validate required fields
            if (customerId == 0)
            {
                errorMessage = "Please select a customer";
                StateHasChanged();
                return;
            }

            if (paymentTermId == 0)
            {
                errorMessage = "Please select a payment term";
                StateHasChanged();
                return;
            }

            // Validate line items
            if (lineItems == null || lineItems.Count == 0)
            {
                errorMessage = "Please add at least one line item";
                StateHasChanged();
                return;
            }

            // Check if all line items have valid data
            var invalidLines = lineItems.Where(l => l.ItemId.GetValueOrDefault() <= 0 ||
                l.MeasurementId.GetValueOrDefault() <= 0 || l.Quantity.GetValueOrDefault() <= 0 ||
                l.Amount.GetValueOrDefault() <= 0 || l.Discount.GetValueOrDefault() < 0 ||
                l.Discount.GetValueOrDefault() > 100).ToList();
            if (invalidLines.Any())
            {
                errorMessage = "All line items must have Item, Unit, Quantity, and Price per Unit selected";
                StateHasChanged();
                return;
            }

            CalculateTotalAmount();
            isSaving = true;
            string apiurl = System.Environment.GetEnvironmentVariable("APIURL") ?? "http://localhost:8001/api/";

            // Build payload conditionally - only include FromSalesOrderId if we're creating from an existing order
            var payload = new Dictionary<string, object>
{
{ "Id", invoiceId },
{ "No", invoiceNumber.ToString(CultureInfo.InvariantCulture) },
{ "CustomerId", customerId },
{ "InvoiceDate", invoiceDate },
{ "PaymentTermId", paymentTermId },
{ "Shipping", shipping },
{ "SalesInvoiceLines", lineItems.Select(line => new
{
Id = line.Id, // Include the SalesOrderLine.Id to prevent duplication
ItemId = line.ItemId,
Quantity = line.Quantity,
Amount = line.Amount,
Discount = line.Discount ?? 0,
MeasurementId = line.MeasurementId
}).ToList() }
};

            // Only include FromSalesOrderId if we're creating from an existing order
            if (IsFromOrder)
            {
                payload["FromSalesOrderId"] = OrderId!.Value;
            }

            var client = ClientFactory.CreateClient();
            var json = JsonSerializer.Serialize(payload);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

            var response = await client.PostAsync($"{apiurl}sales/SaveSalesInvoice", content);

            if (response.IsSuccessStatusCode)
            {
                await Task.Delay(100);
                Navigation.NavigateTo("/Sales/SalesOrders?tab=invoices", forceLoad: true);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to save invoice. Status: {response.StatusCode}. Response: {errorContent}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving invoice: {ex.Message}";
            StateHasChanged();
        }
        finally
        {
            isSaving = false;
        }
    }
}
