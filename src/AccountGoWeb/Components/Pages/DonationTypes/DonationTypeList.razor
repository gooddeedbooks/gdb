@namespace GoodBooks.DonationTypes.Components
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Configuration
@using Dto.DonationTypes
@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration

<PageTitle>Donation Types</PageTitle>

<div class="container-fluid">
    <h1 class="h3 mb-3">Donation Types</h1>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <a class="btn btn-primary" href="/donation-types/new"><i class="fas fa-plus" aria-hidden="true"></i> New Donation Type</a>
        <input class="form-control form-control-themed w-auto mw-100" type="search" aria-label="Search donation types"
               placeholder="Search donation types" @bind="search" @bind:event="oninput" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger text-danger" role="alert">@errorMessage
            <button class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadAsync">Retry</button>
        </div>
    }
    @if (pendingDelete != null)
    {
        <div class="alert alert-warning" role="alert">
            Delete @pendingDelete.Name?
            <button class="btn btn-sm btn-danger ms-2" disabled="@isDeleting" @onclick="DeleteAsync">
                <i class="fas fa-trash" aria-hidden="true"></i> Delete
            </button>
            <button class="btn btn-sm btn-secondary ms-2" disabled="@isDeleting" @onclick="CancelDelete">Cancel</button>
        </div>
    }
    @if (isLoading)
    {
        <div role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading donation types...</div>
    }
    else if (items.Count == 0 && string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-info">No donation types found.</div>
    }
    else if (items.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered align-middle">
                <thead>
                    <tr>
                        <th scope="col">Name <button class="btn btn-sm btn-link" title="Sort by name"
                                                     aria-label="Sort by name" @onclick="ToggleSort"><i class="fas fa-sort"
                                                                               aria-hidden="true"></i></button></th>
                        <th scope="col">Description</th>
                        <th scope="col">G/L Code</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Filtered)
                    {
                        <tr @key="item.Id">
                            <td><a href="/donation-types/@item.Id">@item.Name</a></td>
                            <td>@item.Description</td>
                            <td>@(string.IsNullOrEmpty(item.GlAccountCode) ? "" : item.GlAccountCode + " - " + item.GlAccountName)</td>
                            <td class="text-nowrap">
                                <a class="btn btn-sm btn-secondary" href="/donation-types/@item.Id" title="Edit donation type"
                                   aria-label="Edit @item.Name"><i class="fas fa-pen" aria-hidden="true"></i></a>
                                <button class="btn btn-sm btn-outline-danger ms-1" title="Delete donation type"
                                        aria-label="Delete @item.Name" disabled="@isDeleting"
                                        @onclick="() => pendingDelete = item"><i class="fas fa-trash" aria-hidden="true"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Filtered.Any())
        {
            <p class="text-muted">No matching donation types.</p>
        }
        <p class="text-muted">Total: @Filtered.Count() donation type(s)</p>
    }
</div>

@code {
    private List<DonationType> items = new List<DonationType>();
    private DonationType? pendingDelete;
    private string search = string.Empty;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isDeleting;
    private bool sortAscending = true;

    private string ApiUrl
    {
        get
        {
            return (Configuration["ApiUrl"] ?? Environment.GetEnvironmentVariable("APIURL") ??
"http://localhost:8001/api/").TrimEnd('/') + "/donation-types";
        }
    }

    private IEnumerable<DonationType> Filtered
    {
        get
        {
            var filtered = items.Where(item => string.IsNullOrWhiteSpace(search) ||
                (item.Name + " " + item.Description).IndexOf(search, StringComparison.OrdinalIgnoreCase) >= 0);
            return sortAscending ? filtered.OrderBy(item => item.Name) : filtered.OrderByDescending(item => item.Name);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            using (var client = ClientFactory.CreateClient())
            {
                items = await client.GetFromJsonAsync<List<DonationType>>(ApiUrl) ?? new List<DonationType>();
                pendingDelete = null;
            }
        }
        catch (HttpRequestException exception)
        {
            errorMessage = exception.StatusCode.HasValue
                ? $"Unable to load donation types (HTTP {(int)exception.StatusCode.Value} {exception.StatusCode}). Retry loading the list."
                : "Unable to reach the API. Check that the API is running, then select Retry.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "Loading donation types timed out. Select Retry to load the list again.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "The API returned an unreadable donation type list. Select Retry.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleSort()
    {
        sortAscending = !sortAscending;
    }

    private void CancelDelete()
    {
        pendingDelete = null;
    }

    private async Task DeleteAsync()
    {
        if (pendingDelete == null || isDeleting) return;
        isDeleting = true;
        errorMessage = null;
        try
        {
            using (var client = ClientFactory.CreateClient())
            using (var response = await client.DeleteAsync(ApiUrl + "/" + pendingDelete.Id))
            {
                response.EnsureSuccessStatusCode();
                items.Remove(pendingDelete);
                pendingDelete = null;
            }
        }
        catch (HttpRequestException exception)
        {
            errorMessage = exception.StatusCode.HasValue
                ? $"Unable to delete this donation type (HTTP {(int)exception.StatusCode.Value} {exception.StatusCode}). Select Retry to refresh the list."
                : "The connection to the API failed during deletion. Select Retry to refresh the list and check whether it was deleted.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "The delete request timed out. Select Retry to refresh the list and check whether it was deleted.";
        }
        finally
        {
            isDeleting = false;
        }
    }
}
