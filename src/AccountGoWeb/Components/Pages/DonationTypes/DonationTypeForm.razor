@namespace GoodBooks.DonationTypes.Components
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Configuration
@using Dto.DonationTypes
@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<PageTitle>@(Id == 0 ? "New Donation Type" : "Edit Donation Type")</PageTitle>

<div class="container-fluid">
    <h1 class="h3 mb-3">@(Id == 0 ? "New Donation Type" : "Edit Donation Type")</h1>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger text-danger" role="alert">@errorMessage</div>
    }
    @if (isLoading)
    {
        <div role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading donation type...</div>
    }
    else if (isLoaded)
    {
        <EditForm @key="editContext" EditContext="editContext" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <fieldset disabled="@isSaving">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="donation-type-name">Name</label>
                        <InputText id="donation-type-name" class="form-control form-control-themed"
                                   @bind-Value="model.Name" maxlength="100" />
                        <ValidationMessage class="text-danger" For="() => model.Name" />
                    </div>
                </div>
                <div class="row g-3 mt-0">
                    <div class="col-md-6">
                        <label class="form-label" for="donation-type-description">Description</label>
                        <InputTextArea id="donation-type-description" class="form-control form-control-themed"
                                       @bind-Value="model.Description" maxlength="500" rows="3" />
                        <ValidationMessage class="text-danger" For="() => model.Description" />
                    </div>
                </div>
                <div class="row g-3 mt-0">
                    <div class="col-md-6">
                        <label class="form-label" for="donation-type-gl-code">G/L Codes</label>
                        <InputSelect id="donation-type-gl-code" class="form-select form-control-themed"
                                     @bind-Value="model.GlAccountId">
                            <option value="">-- Select G/L Code --</option>
                            @foreach (var account in accounts)
                            {
                                <option value="@account.Id">@account.AccountCode - @account.AccountName</option>
                            }
                        </InputSelect>
                        <ValidationMessage class="text-danger" For="() => model.GlAccountId" />
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save" aria-hidden="true"></i> Save
                    </button>
                    <a class="btn btn-secondary ms-2" href="/donation-types">Cancel</a>
                </div>
            </fieldset>
        </EditForm>
    }
    else
    {
        <a class="btn btn-secondary" href="/donation-types">Back to Donation Types</a>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    [Parameter]
    public bool ForceLoad { get; set; }

    private DonationType model = new DonationType();
    private EditContext editContext = new EditContext(new DonationType());
    private bool isLoading = true;
    private bool isLoaded;
    private bool isSaving;
    private string? errorMessage;
    private List<Dto.Financial.Account> accounts = new List<Dto.Financial.Account>();

    private string ApiUrl
    {
        get
        {
            return (Configuration["ApiUrl"] ?? Environment.GetEnvironmentVariable("APIURL") ??
"http://localhost:8001/api/").TrimEnd('/') + "/donation-types";
        }
    }

    private string AccountsUrl
    {
        get
        {
            return (Configuration["ApiUrl"] ?? Environment.GetEnvironmentVariable("APIURL") ??
"http://localhost:8001/api/").TrimEnd('/') + "/donations/DonationAccounts";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        isLoaded = false;
        errorMessage = null;
        model = new DonationType();
        try
        {
            using (var accountsClient = ClientFactory.CreateClient())
            {
                accounts = await accountsClient.GetFromJsonAsync<List<Dto.Financial.Account>>(AccountsUrl) ?? new List<Dto.Financial.Account>();
                accounts = accounts.Where(account => account.AccountCode != "41000").ToList();
            }
            if (Id != 0)
            {
                using (var client = ClientFactory.CreateClient())
                using (var response = await client.GetAsync(ApiUrl + "/" + Id))
                {
                    if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
                    {
                        errorMessage = "Donation type not found (HTTP 404). It may have been deleted.";
                        return;
                    }
                    response.EnsureSuccessStatusCode();
                    var loaded = await response.Content.ReadFromJsonAsync<DonationType>();
                    if (loaded == null)
                    {
                        errorMessage = "The API returned an empty donation type record.";
                        return;
                    }
                    model = loaded;
                }
            }
            editContext = new EditContext(model);
            isLoaded = true;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = exception.StatusCode.HasValue
                ? $"Unable to load this donation type (HTTP {(int)exception.StatusCode.Value} {exception.StatusCode})."
                : "Unable to reach the API. Check that the API is running.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "Loading the donation type timed out.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "The API returned an unreadable donation type record.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (isSaving) return;
        isSaving = true;
        errorMessage = null;
        try
        {
            using (var client = ClientFactory.CreateClient())
            using (var response = Id == 0
                ? await client.PostAsJsonAsync(ApiUrl, model)
                : await client.PutAsJsonAsync(ApiUrl + "/" + Id, model))
            {
                if (!response.IsSuccessStatusCode)
                {
                    if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                    {
                        var problem = await response.Content.ReadFromJsonAsync<Microsoft.AspNetCore.Mvc.ValidationProblemDetails>();
                        errorMessage = problem != null && problem.Errors.Count > 0
                            ? string.Join(" ", problem.Errors.Values.SelectMany(messages => messages))
                            : "The API rejected the donation type (HTTP 400). Check the name and description.";
                    }
                    else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
                        errorMessage = "This donation type no longer exists (HTTP 404). Your changes were not saved.";
                    else
                        errorMessage = $"The API could not save the donation type (HTTP {(int)response.StatusCode} {response.StatusCode}). Your entered details have been kept.";
                    return;
                }
                Navigation.NavigateTo("/donation-types", ForceLoad);
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "The connection to the API failed while saving. Your entered details have been kept.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "The save request timed out. Your entered details have been kept.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "The API returned an unreadable error response. Your entered details have been kept.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
